---
import { site } from '../../config/site';
import { pillars } from '../../data/content';
import { images } from '../../data/images';
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section about" id="sobre" aria-labelledby="sobre-title">
  <div class="container about__grid">
    <div class="about__visual" data-reveal="zoom">
      <Media image={images.about} class="about__media" sizes="(min-width: 1024px) 45vw, 100vw" />
      <img
        class="about__stamp"
        src="/images/logo-bicho-solto.png"
        alt=""
        width="112"
        height="112"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about__content">
      <SectionHeading
        id="sobre-title"
        eyebrow="Um lugar para eles"
        title="Mais do que cuidado. Um lugar onde eles se sentem em casa."
        text={`A ${site.fullName} reúne diferentes serviços para cuidar da saúde, higiene, bem-estar e conforto do seu pet em um só lugar.`}
      />

      <ul class="pillars" aria-label="O que cuidamos">
        {
          pillars.map((pillar, index) => (
            <li class="pillar" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="pillar__icon">
                <Icon name={pillar.icon} size={22} />
              </span>
              <span class="pillar__title">{pillar.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .about__visual {
    position: relative;
    padding-right: 1.5rem;
  }

  .about__visual :global(.about__media) {
    aspect-ratio: 4 / 5;
    border-radius: 200px 200px var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .about__visual::before {
    content: '';
    position: absolute;
    inset: 2.5rem 0 -1.5rem 3rem;
    border: 2px solid var(--c-yellow);
    border-radius: 200px 200px var(--radius-lg) var(--radius-lg);
    z-index: -1;
  }

  .about__stamp {
    position: absolute;
    right: 0;
    bottom: 18%;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 5px solid var(--c-black);
    box-shadow: var(--shadow-lg);
  }

  .about__content {
    display: grid;
    gap: 2.5rem;
  }

  .pillars {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .pillar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .pillar:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: transparent;
  }

  .pillar:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--c-yellow);
    color: var(--c-black);
  }

  .pillar__title {
    font-weight: 600;
    color: var(--c-black);
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pillar:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
