---
import { links, site } from '../../config/site';
import { whatsappLink } from '../../lib/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section contact" id="contato" aria-labelledby="contato-title">
  <div class="container contact__grid">
    <div class="contact__info">
      <SectionHeading id="contato-title" eyebrow="Contato" title={site.fullName} />

      <address class="contact__list">
        <div class="contact__item" data-reveal>
          <span class="contact__icon"><Icon name="map-pin" /></span>
          <div>
            <p class="contact__label">Endereço</p>
            <p>
              {site.address.street} - {site.address.district}<br />
              {site.address.city} - {site.address.state}<br />
              CEP {site.address.postalCode}
            </p>
          </div>
        </div>

        <div class="contact__item" data-reveal style="--reveal-delay: 80ms">
          <span class="contact__icon"><Icon name="phone" /></span>
          <div>
            <p class="contact__label">Telefone / WhatsApp</p>
            <p><a href={links.phone}>{site.phone.display}</a></p>
          </div>
        </div>

        <div class="contact__item" data-reveal style="--reveal-delay: 160ms">
          <span class="contact__icon"><Icon name="clock" /></span>
          <div>
            <p class="contact__label">Horário</p>
            <p>Clínica Veterinária: 24 horas</p>
          </div>
        </div>
      </address>

      <div class="contact__actions" data-reveal>
        <Button href={whatsappLink('geral')} icon="whatsapp">Falar pelo WhatsApp</Button>
        <Button href={links.maps} variant="secondary" icon="map-pin">Abrir no Google Maps</Button>
      </div>

      <div class="contact__social" data-reveal>
        <span>Siga a Bicho Solto</span>
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <Icon name="instagram" size={20} />
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <Icon name="facebook" size={20} />
        </a>
      </div>
    </div>

    <div class="contact__map" data-reveal="zoom">
      <iframe
        src={links.mapsEmbed}
        title={`Mapa: ${site.fullName} em ${site.address.city}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .contact__info {
    display: grid;
    gap: 2.25rem;
    align-content: start;
  }

  .contact__list {
    display: grid;
    gap: 0.75rem;
    font-style: normal;
  }

  .contact__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--c-white);
    border: 1px solid var(--c-line);
  }

  .contact__item a {
    font-weight: 600;
    text-decoration: none;
    color: var(--c-black);
  }

  .contact__item a:hover {
    color: var(--c-accent-text);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--c-yellow);
    color: var(--c-black);
  }

  .contact__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent-text);
    margin-bottom: 0.2rem;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact__social {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .contact__social span {
    margin-right: 0.4rem;
  }

  .contact__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--c-line-strong);
    color: var(--c-black);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .contact__social a:hover {
    background: var(--c-yellow);
    border-color: var(--c-yellow);
    color: var(--c-black);
  }

  .contact__map {
    min-height: 380px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--c-warm);
    box-shadow: var(--shadow);
  }

  .contact__map iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
    filter: grayscale(0.35) sepia(0.12);
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .contact__map,
    .contact__map iframe {
      min-height: 100%;
    }
  }
</style>
