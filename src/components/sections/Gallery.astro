---
import { site } from '../../config/site';
import { momentsGallery } from '../../data/images';
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section moments" aria-labelledby="momentos-title">
  <div class="container">
    <div class="moments__head">
      <SectionHeading id="momentos-title" eyebrow="Galeria" title="Momentos Bicho Solto" />
      <a
        class="moments__insta"
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
      >
        <Icon name="instagram" size={18} />
        @bichosoltojoinville
      </a>
    </div>

    <ul class="moments__grid" aria-label="Galeria de fotos">
      {
        momentsGallery.map((image, index) => (
          <li class="moments__item" data-reveal="fade" style={`--reveal-delay: ${(index % 4) * 70}ms`}>
            <Media
              image={image}
              class="moments__media"
              sizes="(min-width: 1024px) 25vw, 50vw"
              widths={[400, 700, 1000]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .moments__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .moments__insta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: start;
    min-height: 44px;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--c-sand);
  }

  .moments__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 160px;
    grid-auto-flow: dense;
    gap: 0.75rem;
  }

  .moments__item {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .moments__item :global(.moments__media) {
    height: 100%;
  }

  .moments__item :global(.moments__media img) {
    filter: saturate(0.92);
    transition:
      transform 1.2s var(--ease-out),
      filter var(--dur-slow) var(--ease-out),
      opacity 0.6s ease;
  }

  .moments__item:hover :global(.moments__media img) {
    transform: scale(1.06);
    filter: saturate(1.05);
  }

  /* Ritmo editorial */
  .moments__item:nth-child(1) {
    grid-row: span 2;
  }
  .moments__item:nth-child(4) {
    grid-row: span 2;
  }
  .moments__item:nth-child(7) {
    grid-column: span 2;
  }

  @media (min-width: 768px) {
    .moments__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .moments__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 200px;
      gap: 1rem;
    }
    .moments__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .moments__item:nth-child(4) {
      grid-row: auto;
    }
    .moments__item:nth-child(5) {
      grid-row: span 2;
    }
    .moments__item:nth-child(6) {
      grid-column: span 2;
    }
    .moments__item:nth-child(7) {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .moments__grid {
      grid-auto-rows: 230px;
    }
  }
</style>
