---
import { structureGallery } from '../../data/images';
import Media from '../ui/Media.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section structure" id="estrutura" aria-labelledby="estrutura-title">
  <div class="container">
    <SectionHeading
      id="estrutura-title"
      eyebrow="Nossa estrutura"
      title="Um espaço pensado para o bem-estar deles."
      align="center"
    />

    <ul class="bento" aria-label="Galeria da estrutura">
      {
        structureGallery.map((image, index) => (
          <li class="bento__item" data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <Media
              image={image}
              class="bento__media"
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw"
              widths={[480, 800, 1200]}
            />
            <span class="bento__label">{image.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 180px;
  }

  .bento__item {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .bento__item:nth-child(1),
  .bento__item:nth-child(4) {
    grid-column: span 2;
    grid-row: span 1;
  }

  .bento__item :global(.bento__media) {
    height: 100%;
  }

  .bento__item::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 50%, rgb(20 20 20 / 0.55));
    pointer-events: none;
  }

  .bento__item:hover :global(.bento__media img) {
    transform: scale(1.05);
  }

  .bento__label {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    z-index: 2;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgb(250 247 240 / 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--c-black);
    font-size: 0.8rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 220px;
      gap: 1rem;
    }
    .bento__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bento__item:nth-child(4),
    .bento__item:nth-child(5),
    .bento__item:nth-child(6) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-auto-rows: 250px;
    }
    .bento__item {
      border-radius: var(--radius-lg);
    }
  }
</style>
