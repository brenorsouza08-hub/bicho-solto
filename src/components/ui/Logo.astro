---
import { site } from '../../config/site';

interface Props {
  tone?: 'dark' | 'light';
  href?: string;
}

const { tone = 'dark', href = '#inicio' } = Astro.props;
---

<a href={href} class:list={['logo', `logo--${tone}`]} aria-label={`${site.fullName} — início`}>
  <!-- Logo oficial. Para melhor nitidez, substitua pelo arquivo original em alta resolução. -->
  <img
    class="logo__mark"
    src="/images/logo-bicho-solto.png"
    alt=""
    width="48"
    height="48"
    decoding="async"
  />
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__tagline">{site.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--c-black);
  }
  .logo__mark {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--c-black);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .logo:hover .logo__mark {
    transform: rotate(-10deg) scale(1.04);
  }
  .logo__text {
    display: grid;
    line-height: 1;
  }
  .logo__name {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .logo__tagline {
    margin-top: 0.3rem;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--c-accent-text);
  }
  .logo--light {
    color: var(--c-cream);
  }
  .logo--light .logo__mark {
    box-shadow: 0 0 0 2px var(--c-yellow);
  }
  .logo--light .logo__tagline {
    color: var(--c-accent);
  }
</style>
