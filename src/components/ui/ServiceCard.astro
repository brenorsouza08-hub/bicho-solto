---
import type { Service } from '../../data/content';
import { whatsappLink } from '../../lib/whatsapp';
import Icon from './Icon.astro';
import Media from './Media.astro';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="card" id={service.id} data-reveal style={`--reveal-delay: ${(index % 2) * 90}ms`}>
  <div class="card__media-wrap">
    <Media
      image={service.image}
      class="card__media"
      sizes="(min-width: 1024px) 28vw, (min-width: 640px) 50vw, 100vw"
      widths={[480, 720, 960]}
    />
    <span class="card__icon">
      <Icon name={service.icon} size={22} />
    </span>
  </div>
  <div class="card__body">
    <span class="card__number" aria-hidden="true">{number}</span>
    <h3 class="card__title">{service.title}</h3>
    <p class="card__text">{service.description}</p>
    <a
      class="card__link"
      href={whatsappLink(service.whatsapp)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${service.cta}: ${service.title} (abre o WhatsApp)`}
    >
      {service.cta}
      <Icon name="arrow-up-right" size={18} />
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    overflow: hidden;
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--c-yellow);
  }

  .card__media-wrap {
    position: relative;
    padding: 0.6rem 0.6rem 0;
  }

  .card__media-wrap :global(.card__media) {
    aspect-ratio: 4 / 3.2;
    border-radius: calc(var(--radius-lg) - 8px);
  }

  .card:hover :global(.card__media img) {
    transform: scale(1.05);
  }

  .card__icon {
    position: absolute;
    left: 1.5rem;
    bottom: -1.4rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--c-yellow);
    color: var(--c-black);
    border: 4px solid var(--c-white);
  }

  .card__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2.4rem 1.5rem 1.6rem;
  }

  .card__number {
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--c-accent-text);
    letter-spacing: 0.08em;
  }

  .card__text {
    color: var(--c-muted);
    flex: 1;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--c-black);
    text-decoration: none;
    border-bottom: 2px solid var(--c-yellow);
    transition:
      gap var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .card__link:hover {
    gap: 0.7rem;
    border-color: var(--c-black);
  }
</style>
