---
import { whatsappLink } from '../../lib/whatsapp';
import Icon from './Icon.astro';
---

<a
  class="wa-float"
  href={whatsappLink('geral')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar pelo WhatsApp"
>
  <span class="wa-float__label">Fale conosco</span>
  <span class="wa-float__icon">
    <Icon name="whatsapp" size={28} />
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    animation: wa-in 0.8s var(--ease-out) 1.2s both;
  }

  .wa-float__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 14px 30px -10px rgb(18 140 70 / 0.65);
    transition: transform var(--dur) var(--ease-out);
  }

  .wa-float__icon::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #25d366;
    animation: wa-ring 2.8s ease-out 2s infinite;
  }

  .wa-float__label {
    display: none;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--c-white);
    color: var(--c-forest);
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateX(8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .wa-float:hover .wa-float__icon {
    transform: scale(1.06);
  }

  .wa-float:hover .wa-float__label,
  .wa-float:focus-visible .wa-float__label {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (min-width: 768px) {
    .wa-float__label {
      display: inline-block;
    }
  }

  @keyframes wa-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.9);
    }
  }

  @keyframes wa-ring {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  :global(body.menu-open) .wa-float {
    opacity: 0;
    pointer-events: none;
  }
</style>
