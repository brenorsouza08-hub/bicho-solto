---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light' | 'outline-light';
  size?: 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'start',
  external = /^https?:\/\//.test(href),
  class: className,
  ariaLabel,
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  aria-label={ariaLabel}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={20} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={18} class="btn__end-icon" />}
</a>

<style>
  .btn {
    --btn-bg: var(--c-primary);
    --btn-fg: var(--c-on-primary);
    --btn-border: transparent;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 52px;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--btn-border);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-weight: 600;
    font-size: 0.975rem;
    letter-spacing: 0.005em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .btn--lg {
    min-height: 58px;
    padding: 1rem 1.9rem;
    font-size: 1.025rem;
  }

  .btn:hover {
    transform: translateY(-2px);
  }
  .btn:active {
    transform: translateY(0);
  }

  .btn :global(.btn__end-icon) {
    transition: transform var(--dur) var(--ease-out);
  }
  .btn:hover :global(.btn__end-icon) {
    transform: translateX(3px);
  }

  .btn--primary {
    box-shadow: 0 10px 24px -12px rgb(var(--c-primary-rgb) / 0.7);
  }
  .btn--primary:hover {
    --btn-bg: var(--c-primary-strong);
    box-shadow: 0 16px 32px -14px rgb(var(--c-primary-rgb) / 0.8);
  }

  .btn--secondary {
    --btn-bg: transparent;
    --btn-fg: var(--c-ink);
    --btn-border: var(--c-line-strong);
  }
  .btn--secondary:hover {
    --btn-bg: var(--c-surface);
    --btn-border: var(--c-ink);
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-fg: var(--c-primary);
    padding-inline: 0.25rem;
    min-height: 44px;
  }
  .btn--ghost:hover {
    transform: none;
    --btn-fg: var(--c-primary-strong);
  }

  .btn--light {
    --btn-bg: var(--c-cream);
    --btn-fg: var(--c-forest);
  }
  .btn--light:hover {
    --btn-bg: #fff;
    box-shadow: 0 16px 32px -16px rgb(0 0 0 / 0.5);
  }

  .btn--outline-light {
    --btn-bg: transparent;
    --btn-fg: var(--c-cream);
    --btn-border: rgb(246 242 234 / 0.35);
  }
  .btn--outline-light:hover {
    --btn-border: var(--c-cream);
    --btn-bg: rgb(246 242 234 / 0.08);
  }

  @media (max-width: 479px) {
    .btn:not(.btn--ghost) {
      width: 100%;
    }
  }
</style>
