---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Emergency from '../components/sections/Emergency.astro';
import Structure from '../components/sections/Structure.astro';
import Experience from '../components/sections/Experience.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Gallery from '../components/sections/Gallery.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
---

<BaseLayout>
  <Header slot="header" />

  <Hero />
  <About />
  <Services />
  <Emergency />
  <Structure />
  <Experience />
  <Testimonials />
  <Gallery />
  <CallToAction />
  <Contact />

  <Fragment slot="footer">
    <Footer />
    <WhatsAppFloat />
  </Fragment>
</BaseLayout>
